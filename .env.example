# =============================================================================
# SMS SENTINEL — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and provide your actual secrets.
# NEVER commit .env or real secret keys into version control or share publicly.

# --- Application & Session Security ---
SECRET_KEY=your-cryptographic-flask-secret-key-here-minimum-32-chars
PORT=5555
HOST=127.0.0.1
FLASK_DEBUG=false

# --- Google OAuth 2.0 / OpenID Connect ---
# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI (Local): http://localhost:5555/auth/google/callback
# Authorized Redirect URI (Production): https://YOUR-DOMAIN.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override if different from auto-derived URL:
# GOOGLE_REDIRECT_URI=http://localhost:5555/auth/google/callback

# --- GitHub OAuth Web Application ---
# Obtain from: https://github.com/settings/developers
# Authorization Callback URL (Local): http://localhost:5555/auth/github/callback
# Authorization Callback URL (Production): https://YOUR-DOMAIN.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional override if different from auto-derived URL:
# GITHUB_REDIRECT_URI=http://localhost:5555/auth/github/callback

# --- Microsoft Entra ID / Azure AD OpenID Connect ---
# Obtain from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Redirect URI (Local): http://localhost:5555/auth/microsoft/callback
# Redirect URI (Production): https://YOUR-DOMAIN.com/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Default tenant is 'common' for multi-tenant & personal accounts, or specify your Tenant ID:
MICROSOFT_TENANT_ID=common
# Optional override if different from auto-derived URL:
# MICROSOFT_REDIRECT_URI=http://localhost:5555/auth/microsoft/callback
